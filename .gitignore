node_modules/
*.log
.DS_Store
# GitX: only the commit graph (.gitx/commits) is shared with the repo.
# Everything else under .gitx - thoughts, the context graph, stashes, the
# thought log, worktrees, task state - is private to whoever owns this clone.
# Ignore-all-then-share-one, so a folder added later is private without
# anyone remembering a line for it (see ensureGitignored in mcp/server.js).
.gitx/*
!.gitx/commits/
